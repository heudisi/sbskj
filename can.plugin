# 阿里云盘签到开关
[UI Switch]
aliyunqd_enable = 阿里云盘签到开关, false
aliyunqdck_enable = 阿里云盘 CK 开关, false

# 阿里云盘签到脚本
[Script]
cron "0 7,11,17 * * *" script-path=https://gist.githubusercontent.com/Sliverkiss/33800a98dcd029ba09f8b6fc6f0f5162/raw/aliyun.js, timeout=120, tag=阿里云签到, enable={aliyunqd_enable}, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/AliYunDrive.png

# 阿里云盘 CK 脚本
http-request ^https:\/\/(auth|aliyundrive)\.alipan\.com\/v2\/account\/token script-path=https://gist.githubusercontent.com/Sliverkiss/33800a98dcd029ba09f8b6fc6f0f5162/raw/aliyun.js, requires-body=true, timeout=60, tag=aliyun, enable={aliyunqdck_enable}

# MITM 配置
[MITM]
hostname = auth.alipan.com, auth.aliyundrive.com
